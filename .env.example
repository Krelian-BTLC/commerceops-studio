# Copier en .env si besoin. Aucune clé ni secret n'est nécessaire : l'application
# n'appelle aucun service externe. Ne jamais commiter de fichier .env.
COMMERCEOPS_DB=./data/catalog.db
COMMERCEOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMMERCEOPS_MAX_FILE_BYTES=2000000
COMMERCEOPS_MAX_ROWS=10000
COMMERCEOPS_DEMO_ENABLED=true
COMMERCEOPS_LOG_LEVEL=INFO
